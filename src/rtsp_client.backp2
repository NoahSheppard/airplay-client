bool rtsp_pair_setup(AirPlaySession& session, bool DEBUG) {
    int sock = socket(AF_INET, SOCK_STREAM, 0);
    session.control_socket = sock;

    sockaddr_in addr{}; // init the socket
    addr.sin_family = AF_INET;
    addr.sin_port = htons(session.port);
    if (inet_pton(AF_INET, session.host.c_str(), &addr.sin_addr) <= 0) {
        if (DEBUG) std::cout << RED_BOLD << "[rtsp_client.cpp] Closing socket (1)" << WHITE << std::endl;
        close(session.control_socket); // if couldn't create the socket
        return false;
    }

    if (connect(session.control_socket, (sockaddr*)&addr, sizeof(addr)) < 0) {
        if (DEBUG) std::cout << RED_BOLD << "[rtsp_client.cpp] Closing socket (2)" << WHITE << std::endl;
        close(session.control_socket); // if cannot connect to host
        return false;
    }

    // 1. Initialize our TLV8 builder
    TLV8 pair_setup_m1;

    // 2. State = 1
    pair_setup_m1.add(kTLVType_State, {0x01});

    // 3. Method = 4 (Transient Pairing for pw=false devices)
    pair_setup_m1.add(kTLVType_Method, {0x04});

    // 4. Encode to raw bytes
    /*std::vector<uint8_t> body = pair_setup_m1.encode();
    std::cout << YELLOW << "[rtsp_client.cpp] Body=";
    for (unsigned char c : body) {
        std::cout << static_cast<int>(c) << " "; 
    } 
    std::cout << WHITE << std::endl;*/

    // 5. Build the HTTP POST Request
    // The exact 16-byte FairPlay SAP v2.5 M1 Payload
    std::vector<uint8_t> body = {
        0x46, 0x50, 0x4C, 0x59, // "FPLY"
        0x02, 0x01, 0x01, 0x00, 
        0x00, 0x00, 0x00, 0x00, 
        0x00, 0x00, 0x00, 0x00
    };

    // Generate a pseudo-random Session ID and Device ID
    std::string session_id = "00000000-1111-2222-3333-444455556666"; // Usually a UUID
    std::string device_id = "0x001122334455"; // Spoofed MAC address of the client

    // Build the HTTP POST Request mimicking Windows iTunes
    std::ostringstream req;
    req << "POST /fp-setup HTTP/1.1\r\n"
        << "Host: " << session.host << ":" << session.port << "\r\n"
        << "User-Agent: iTunes/12.12.9 (Windows; Microsoft Windows 10 x64) AppleWebKit/7614.1000.18.22\r\n"
        << "Content-Type: application/octet-stream\r\n"
        << "Content-Length: " << body.size() << "\r\n"
        << "X-Apple-Session-ID: " << session_id << "\r\n"
        << "X-Apple-Device-ID: " << device_id << "\r\n"
        << "\r\n";

    std::string request_headers = req.str();
    std::vector<uint8_t> full_request(request_headers.begin(), request_headers.end());
    full_request.insert(full_request.end(), body.begin(), body.end());

    if (send(session.control_socket, full_request.data(), full_request.size(), 0) < 0) {
        std::cerr << "[pair-setup] Failed to send M1 request." << std::endl;
        return false;
    }

    // 7. Receive the M2 response robustly
    char buffer[4096];
    std::string response_data;
    ssize_t bytes_read;
    
    int expected_body_length = -1;
    size_t header_end_pos = std::string::npos;

    while ((bytes_read = recv(session.control_socket, buffer, sizeof(buffer), 0)) > 0) {
        response_data.append(buffer, bytes_read);
        
        // 1. Look for the end of the HTTP headers if we haven't found it yet
        if (header_end_pos == std::string::npos) {
            header_end_pos = response_data.find("\r\n\r\n");
            
            if (header_end_pos != std::string::npos) {
                // We have all the headers! Let's find the Content-Length.
                std::string headers = response_data.substr(0, header_end_pos);
                size_t cl_pos = headers.find("Content-Length: ");
                
                if (cl_pos != std::string::npos) {
                    size_t cl_end = headers.find("\r\n", cl_pos);
                    std::string cl_str = headers.substr(cl_pos + 16, cl_end - (cl_pos + 16));
                    expected_body_length = std::stoi(cl_str);
                } else {
                    // If there's no Content-Length, assume 0 (e.g., 404 Not Found)
                    expected_body_length = 0; 
                }
            }
        }

        // 2. If we know the headers have ended, check if we have the full body
        if (header_end_pos != std::string::npos && expected_body_length >= 0) {
            size_t total_expected_size = header_end_pos + 4 + expected_body_length;
            if (response_data.size() >= total_expected_size) {
                break; // We have everything! Escape the blocking loop.
            }
        }
    }

    // 8. Separate the HTTP Headers from the TLV8 Body
    if (header_end_pos == std::string::npos) {
        std::cerr << "[pair-setup] Invalid HTTP response (no headers found)" << std::endl;
        return false;
    }

    std::string headers = response_data.substr(0, header_end_pos);
    std::vector<uint8_t> m2_body;
    
    if (expected_body_length > 0) {
        m2_body.assign(response_data.begin() + header_end_pos + 4, response_data.end());
    }

    if (DEBUG) std::cout << "\n[pair-setup] Received Response Headers:\n" << headers << std::endl;
    if (DEBUG) std::cout << "[pair-setup] M2 Body length: " << m2_body.size() << " bytes" << std::endl;

    return true;

}

std::string base64_encode(const uint8_t* data, size_t len) {
    BIO* b64 = BIO_new(BIO_f_base64());
    BIO* mem = BIO_new(BIO_s_mem());
    BIO_push(b64, mem);
    BIO_set_flags(b64, BIO_FLAGS_BASE64_NO_NL);
    BIO_write(b64, data, len);
    BIO_flush(b64);

    char* out;
    size_t out_len = BIO_get_mem_data(mem, &out);
    std::string result(out, out_len);

    BIO_free_all(b64);
    return result;
}